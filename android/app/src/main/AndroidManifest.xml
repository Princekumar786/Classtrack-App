<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Firebase Analytics pulls in the advertising-ID permission by default.
         ClassTrack has no ads and only uses Analytics for internal feature-usage,
         so we explicitly REMOVE it. This keeps the Play "advertising ID"
         data-safety answer a truthful "No" and avoids collecting the ad ID. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <!-- Exact alarms so time-critical reminders (class start, daily 7:30
         summary) fire on time instead of being batched by Doze. The app
         degrades gracefully to inexact alarms if this isn't granted. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <application
        android:label="ClassTrack"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Receive links/text shared TO ClassTrack from the system share
                 sheet (e.g. a YouTube video). Handled by receive_sharing_intent;
                 the app opens the editable "New item" sheet pre-filled with the
                 shared URL. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- PostHog: use MANUAL initialisation. The SDK is configured from Dart
             in main.dart (_initPostHog) so we control the host, debug/opt-out
             gating and error tracking. AUTO_INIT=false stops the native SDK
             from self-initialising from manifest meta-data before Dart runs. -->
        <meta-data
            android:name="com.posthog.posthog.AUTO_INIT"
            android:value="false" />

        <!-- Firebase Cloud Messaging: channel used to display pushes received
             while the app is in the background/terminated. Must match
             kPushChannelId in lib/services/push_messaging_service.dart, which
             creates the channel at runtime. Without this, background pushes
             land in a low-importance fallback channel and don't pop up. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="classtrack_push" />
        <!-- Monochrome status-bar icon for background/terminated FCM pushes.
             Must be a white/transparent drawable, else Android shows a blank
             dot (the full-colour launcher icon flattens to a solid square). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <!-- Tint applied to the (monochrome) status-bar notification icon. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_launcher_background" />

        <!-- flutter_local_notifications: reschedule after reboot -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- flutter_local_notifications: REQUIRED for notification action
             buttons. The after-class "How was <subject>?" check-in shows
             Present / Absent buttons; without this receiver declared, tapping
             them does nothing (and the app is never launched to record the
             mark), so the after-class attendance nudge appears "broken" while
             plain body-tap reminders keep working. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />

        <!-- ClassTrack home-screen widget -->
        <receiver
            android:name=".ClassTrackWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/classtrack_widget_info" />
        </receiver>

        <!-- Neutralise the unused Glance widget action trampolines.
             `home_widget` transitively bundles androidx.glance:glance-appwidget,
             whose InvisibleActionTrampolineActivity crashes with
             "List adapter activity trampoline invoked without specifying target
             intent" when a launcher (or a stale/foreign PendingIntent) fires it
             without the expected target-intent extra — the recurring
             androidx.glance.appwidget.action.ActionTrampoline IllegalArgumentException.
             ClassTrack uses ONLY classic RemoteViews (ClassTrackWidgetProvider),
             so no Glance widget exists and these trampolines are never
             legitimately invoked. Remove them from the merged manifest so the
             stray invocation can't take the app down. -->
        <activity
            android:name="androidx.glance.appwidget.action.InvisibleActionTrampolineActivity"
            tools:node="remove" />
        <activity
            android:name="androidx.glance.appwidget.action.ActionTrampolineActivity"
            tools:node="remove" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: open web links -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
