rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    // CMS role from a custom claim set by the backend (never client-settable).
    function role() {
      return isSignedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : 'none';
    }
    // Roles allowed to author opportunities/discounts content (PRD §28).
    function canEditContent() {
      return role() in ['super_admin', 'admin', 'editor'];
    }
    // Roles allowed to manage banners & sponsored campaigns.
    function canManageMarketing() {
      return role() in ['super_admin', 'admin', 'marketing'];
    }
    function isAdmin() {
      return role() in ['super_admin', 'admin'];
    }
    // Roles allowed to review/moderate reported content.
    function canModerate() {
      return role() in ['super_admin', 'admin', 'moderator'];
    }
    // A resource write must carry the core fields and stamp the editor's uid
    // (so the audit trigger can attribute the change). Server-enforced.
    function contentValid() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0
        && d.type is string && d.type.size() > 0
        && d.status is string
        && d.updatedBy == request.auth.uid;
    }
    // Incomplete resources can't be published: any student-visible status must
    // include an organization and an application/affiliate link (PRD §18).
    // Opportunities (non-discounts) must additionally spell out the benefits
    // and how to apply. Mirrors the client-side CMS check (evaluateResource);
    // Admin SDK writes (Cloud Functions) bypass these rules by design.
    function publishableIfVisible() {
      let d = request.resource.data;
      return (d.status in ['draft', 'hidden'])
        || (d.organization is string && d.organization.size() > 0
            && ((d.applicationUrl is string && d.applicationUrl.size() > 0)
                || (d.affiliateUrl is string && d.affiliateUrl.size() > 0))
            && (d.type == 'discount'
                || (d.benefits is string && d.benefits.size() > 0
                    && d.howToApply is string && d.howToApply.size() > 0)));
    }

    // Referral / reward bookkeeping fields on the user doc are owned ONLY by
    // the backend (Cloud Functions use the Admin SDK, which bypasses these
    // rules). They MUST NOT be client-writable: the referral→Pro self-heal in
    // getReferralInfo trusts `referralCount` / `referralProDaysGranted` /
    // `referredBy`, so a client that could set those (via the raw SDK/REST,
    // bypassing the app) could grant itself unlimited free Pro.
    function referralFields() {
      return ['referralCode', 'referralCount', 'referralProDaysGranted',
              'referredBy', 'referredAt'];
    }

    // Server-trusted Pro check, mirroring the app's isProProvider: a
    // permanent `pro: true` or a future `proUntil` (millis or Timestamp).
    function isPro(uid) {
      let path = /databases/$(database)/documents/_entitlements/$(uid);
      let e = exists(path) ? get(path).data : {};
      return e.get('pro', false) == true
        || (e.get('proUntil', null) is timestamp && e.proUntil > request.time)
        || (e.get('proUntil', null) is int
            && e.proUntil > request.time.toMillis());
    }

    // Free profile characters — MUST match ProfileAvatars.free (the first
    // ProfileAvatars.freeCount entries of ProfileAvatars.all). A guard test in
    // test/profile_avatars_rules_sync_test.dart fails if they drift.
    function freeAvatars() {
      return ['icons8-aang-144.png', 'icons8-adam-savage-144.png',
              'icons8-albus-dumbledore-144.png', 'icons8-amethyst-universe-144.png',
              'icons8-anonymous-mask-144.png', 'icons8-aquaman-144.png',
              'icons8-atom-144.png', 'icons8-badtz-maru-144.png',
              'icons8-batman-144.png', 'icons8-batman-144-2.png',
              'icons8-bendy-144.png', 'icons8-bill-cipher-144.png',
              'icons8-bmo-144.png', 'icons8-brave-144.png',
              'icons8-brutus-144.png'];
    }

    // The profile's avatar is free, unset, or the user is Pro.
    function avatarAllowed(uid) {
      let a = request.resource.data.get('avatarCharacter', null);
      return a == null || a in freeAvatars() || isPro(uid);
    }

    // The lifetime "learning plans created" counter can only go up, so
    // deleting/resetting it can't hand out more free plans.
    function plansCounterNeverDecreases() {
      let before = resource.data.get('learningPlansCreatedCount', 0);
      let after = request.resource.data.get('learningPlansCreatedCount', 0);
      return after is int && after >= before;
    }

    // Everything under a user's tree is private to that user.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // No client delete of the profile doc: account deletion runs server-side
      // (deleteAccount, Admin SDK). Allowing it let a client wipe its
      // free-tier counters (e.g. learningPlansCreatedCount) and start over.
      allow delete: if false;
      // A client may create/update its own profile, but can never set or change
      // the backend-owned referral/reward fields (server-managed via Admin SDK),
      // can never lower its free-tier counters, and can only pick a Pro-only
      // profile character while actually Pro.
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(referralFields())
        && avatarAllowed(uid)
        && !('learningPlansCreatedCount' in request.resource.data
             && request.resource.data.learningPlansCreatedCount != 0);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(referralFields())
        && plansCounterNeverDecreases()
        && (!request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['avatarCharacter'])
            || avatarAllowed(uid));

      // Subcollections only. With rules_version 2, `{document=**}` here would
      // ALSO match users/{uid} itself (zero segments) and grant unconditional
      // write to the profile doc — silently bypassing every check above
      // (referral fields, avatar gate, plan counter). `{sub}/{rest=**}`
      // requires at least one segment below the profile.
      match /{sub}/{rest=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Unified opportunities/discounts content (PRD §7) ──────────────────
    // Students may READ only content that is visible (not draft/hidden); the
    // date-driven lifecycle is re-checked client-side. Editors+ may read all
    // (incl. drafts) and are the ONLY writers — so a student can never modify
    // status, sponsored, priority or any other field.
    match /resources/{id} {
      allow read: if canEditContent() ||
        (isSignedIn() &&
          !(resource.data.status in ['draft', 'hidden']));
      allow create, update: if canEditContent()
        && contentValid() && publishableIfVisible();
      allow delete: if canEditContent();
    }

    // Marketing banners — read published ones; marketing roles manage.
    match /banners/{id} {
      allow read: if canManageMarketing() ||
        (isSignedIn() && resource.data.published == true);
      allow create, update: if canManageMarketing()
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if canManageMarketing();
    }

    // Sponsored campaigns — read published ones; marketing roles manage.
    match /campaigns/{id} {
      allow read: if canManageMarketing() ||
        (isSignedIn() && resource.data.published == true);
      allow create, update: if canManageMarketing()
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if canManageMarketing();
    }

    // Targeted-notification queue. Marketing composes (create) a queued doc;
    // the backend (sendQueuedNotification trigger, Admin SDK) sends it and
    // writes the lifecycle fields. Clients never update/delete.
    match /notifications/{id} {
      allow read: if canManageMarketing();
      allow create: if canManageMarketing()
        && request.resource.data.updatedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // User-submitted content reports (moderation). Any signed-in student may
    // FILE a report attributed to themselves with an initial `open` status;
    // only moderators+ may read the queue or change a report's status. Reports
    // are never deleted (immutable history).
    match /reports/{id} {
      allow read: if canModerate();
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.resourceId is string
        && request.resource.data.resourceId.size() > 0
        && request.resource.data.resourceId.size() <= 200
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 2000;
      allow update: if canModerate();
      allow delete: if false;
    }

    // Analytics pipeline. Students append their own engagement events (create
    // only, never read/modify); a Cloud Function folds them into counters.
    // An event targets EITHER a resource (resourceId) OR a banner (bannerId).
    match /events/{id} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && (
          (request.resource.data.get('resourceId', null) is string
            && request.resource.data.resourceId.size() > 0
            && request.resource.data.resourceId.size() <= 200)
          ||
          (request.resource.data.get('bannerId', null) is string
            && request.resource.data.bannerId.size() > 0
            && request.resource.data.bannerId.size() <= 200)
        )
        && request.resource.data.event is string
        && request.resource.data.event.size() <= 100;
      allow read, update, delete: if false;
    }
    // Aggregated counters — written ONLY by the backend (Admin SDK), readable
    // by any CMS role (all roles may view analytics). Per-day buckets are
    // readable for sponsor reports; per-user unique markers never are.
    match /resourceMetrics/{id} {
      allow read: if role() != 'none';
      allow write: if false;
      match /daily/{day} {
        allow read: if role() != 'none';
        allow write: if false;
      }
    }
    match /bannerMetrics/{id} {
      allow read: if role() != 'none';
      allow write: if false;
      match /daily/{day} {
        allow read: if role() != 'none';
        allow write: if false;
      }
    }
    match /metricsDaily/{id} {
      allow read: if role() != 'none';
      allow write: if false;
    }
    // Audience aggregate for notification recipient estimates. Backend-written;
    // readable by marketing roles (who compose notifications).
    match /audienceCounts/{id} {
      allow read: if canManageMarketing();
      allow write: if false;
    }

    // Managed content taxonomy. Readable by any signed-in user (students see
    // category labels); only content editors may manage it.
    match /categories/{id} {
      allow read: if isSignedIn();
      allow create, update: if canEditContent()
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if canEditContent();
    }

    // Media library index (Cloud Storage assets). Readable by any signed-in
    // user (URLs are used in content); managed by content/marketing roles.
    match /mediaAssets/{id} {
      allow read: if isSignedIn();
      allow create, update: if (canEditContent() || canManageMarketing())
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if canEditContent() || canManageMarketing();
    }

    // Remotely-configurable app config (e.g. recommendation weights). Readable
    // by any signed-in client; only admins may change it.
    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Audit logs of privileged CMS actions. Written ONLY by the backend
    // (Admin SDK — setUserRole + content triggers), readable by admins.
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Server-trusted Pro entitlement. The owner may READ their own flag (so the
    // app can unlock Pro), but only the backend (Admin SDK — RevenueCat webhook
    // or a console edit) may WRITE it. No allow-write rule = client writes are
    // denied, so a user cannot grant themselves Pro.
    match /_entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
